# Relay configuration (all variables use the RELAY_ prefix). Copy to .env; never commit .env.
RELAY_DATABASE_URL=postgresql+asyncpg://relay_app:relay_app@localhost:5433/relay
RELAY_REDIS_URL=redis://localhost:6380/0
# All LLM calls go through the Atlas gateway
RELAY_GATEWAY_URL=http://localhost:8090
RELAY_GATEWAY_KEY=dev-internal-key
RELAY_ATLAS_URL=http://localhost:8000
RELAY_ATLAS_KEY=
# Optional integrations (agents run in dry-run mode without them)
RELAY_GITHUB_APP_ID=
RELAY_GITHUB_PRIVATE_KEY=
RELAY_GITHUB_WEBHOOK_SECRET=change-me
RELAY_SLACK_BOT_TOKEN=
RELAY_SLACK_SIGNING_SECRET=change-me
RELAY_JIRA_URL=
RELAY_JIRA_EMAIL=
RELAY_JIRA_TOKEN=
RELAY_NOTION_TOKEN=
RELAY_OTLP_ENDPOINT=
