tive="1" as="geometry"/></mxCell><mxCell id="1. -fe-17" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="1. -ask-8" target="1. -do-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1. -fe-18" value="rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="1. -ask-8" target="1. -plan-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1. -fe-19" value="next step" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="1. -do-9" target="1. -work-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1. -fe-20" value="done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="1. -do-9" target="1. -report-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1. -fnote-21" value="&lt;font color=&quot;#b0b0b0&quot;&gt;If the agent crashes it resumes from the last step; if it runs out of budget it returns what it has.&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="450.0" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-1" name="2. User flow: code review"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0" background="#121212"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2. -ftitle-22" value="&lt;font color=&quot;#f2f2f2&quot;&gt;&lt;b&gt;Code review agent&lt;/b&gt;&lt;/font&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1100" height="32" as="geometry"/></mxCell><mxCell id="2. -pr-23" value="&lt;b&gt;Open a pull request&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#14332e;strokeColor=#2fbfa5;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -tools-24" value="&lt;b&gt;Run linters + scanners&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;fast, certain checks first&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="255" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -ai-25" value="&lt;b&gt;AI review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;bugs, security, performance&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -verify-26" value="&lt;b&gt;Prove each finding&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#2b2818;strokeColor=#a08a3c;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="697" y="178" width="150" height="80" as="geometry"/></mxCell><mxCell id="2. -drop-27" value="&lt;b&gt;Drop it&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;no evidence = no comment&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#2b2020;strokeColor=#8a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="685" y="350.0" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -post-28" value="&lt;b&gt;Post comments&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;on the exact lines&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -dev-29" value="&lt;b&gt;Developer reacts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;fixes, 👍 or 👎&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -learn-30" value="&lt;b&gt;Track precision&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;noisy rules get tuned&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1d2b1d;strokeColor=#4f8a4f;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="1330" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -fe-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="2. -pr-23" target="2. -tools-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -