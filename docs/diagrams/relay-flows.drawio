" shadow="0" background="#121212"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7. -ftitle-100" value="&lt;font color=&quot;#f2f2f2&quot;&gt;&lt;b&gt;Every tool call goes through the same safety check&lt;/b&gt;&lt;/font&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1100" height="32" as="geometry"/></mxCell><mxCell id="7. -want-101" value="&lt;b&gt;Agent wants to act&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;e.g. post a comment&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#14332e;strokeColor=#2fbfa5;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="7. -budget-102" value="&lt;b&gt;Budget left?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#2b2818;strokeColor=#a08a3c;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="267" y="178" width="150" height="80" as="geometry"/></mxCell><mxCell id="7. -partial-103" value="&lt;b&gt;Stop with partial result&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#2b2020;strokeColor=#8a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="255" y="350.0" width="175" height="56" as="geometry"/></mxCell><mxCell id="7. -kind-104" value="&lt;b&gt;What kind of action?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#2b2818;strokeColor=#a08a3c;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="482" y="178" width="150" height="80" as="geometry"/></mxCell><mxCell id="7. -read-105" value="&lt;b&gt;Read-only&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;allowed&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1d2b1d;strokeColor=#4f8a4f;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="685" y="90" width="175" height="56" as="geometry"/></mxCell><mxCell id="7. -ext-106" value="&lt;b&gt;Writes outside&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;after reading untrusted text?&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="685" y="220.0" width="175" height="56" as="geometry"/></mxCell><mxCell id="7. -block-107" value="&lt;b&gt;Dangerous&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;merge, delete → blocked&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#2b2020;strokeColor=#8a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="685" y="350.0" width="175" height="56" as="geometry"/></mxCell><mxCell id="7. -human-108" value="&lt;b&gt;Human approval&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="220.0" width="175" height="56" as="geometry"/></mxCell><mxCell id="7. -run-109" value="&lt;b&gt;Run once&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;logged for audit&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1d2b1d;strokeColor=#4f8a4f;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="7. -fe-110" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c